import ast
import io
import os
import pathlib
import re
import subprocess
import sys
import tokenize

HASH = chr(35)
SCRIPT_SHEBANGS = (HASH + "!/usr/bin/env python3", HASH + "!/usr/bin/python3")
TS_FAMILY = {".ts", ".tsx", ".js", ".mjs", ".cjs", ".jsx"}
STYLE_FAMILY = {".css"}
HTML_FAMILY = {".html", ".htm"}
YAML_FAMILY = {".yml", ".yaml"}
SHELL_FAMILY = {".sh", ".bash"}
LINE_START_COMMENT = re.compile(r"^\s*(//|/\*|\*)")
QUOTED = re.compile(r"\"(?:\\.|[^\"\\])*\"|'(?:\\.|[^'\\])*'")
TRAILING_HASH = re.compile(r"(^|\s)" + HASH)


def tracked_files(root):
    listed = subprocess.run(["git", "ls-files", "-z"], cwd=root, capture_output=True, check=True)
    names = [name for name in listed.stdout.decode("utf-8").split("\0") if name]
    return [name for name in names if (root / name).is_file() and not (root / name).is_symlink()]


def read_text(path):
    try:
        return path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        return None


def python_findings(name, source):
    found = []
    try:
        for token in tokenize.generate_tokens(io.StringIO(source).readline):
            if token.type == tokenize.COMMENT and not (token.start[0] == 1 and token.string.startswith(HASH + "!")):
                found.append((name, token.start[0], "comment"))
        for node in ast.walk(ast.parse(source)):
            if isinstance(node, (ast.Module, ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)):
                first = node.body[0] if node.body else None
                if isinstance(first, ast.Expr) and isinstance(first.value, ast.Constant) and isinstance(first.value.value, str):
                    found.append((name, first.lineno, "docstring"))
    except (SyntaxError, tokenize.TokenError):
        found.append((name, 1, "unparsable"))
    return found


def ts_findings(name, source):
    found = []
    for number, line in enumerate(source.splitlines(), 1):
        if LINE_START_COMMENT.match(line):
            found.append((name, number, "comment"))
        if number == 1 and line.startswith(HASH) and pathlib.PurePosixPath(name).name != "standin-qd.ts":
            found.append((name, number, "comment"))
    return found


def style_findings(name, source):
    found = []
    index = 0
    while index < len(source):
        char = source[index]
        if char in "\"'":
            end = index + 1
            while end < len(source) and source[end] != char:
                end += 2 if source[end] == "\\" else 1
            index = end + 1
        elif source.startswith("/*", index):
            found.append((name, source.count("\n", 0, index) + 1, "comment"))
            close = source.find("*/", index + 2)
            index = len(source) if close == -1 else close + 2
        else:
            index += 1
    return found


def html_findings(name, source):
    return [(name, source.count("\n", 0, match.start()) + 1, "comment") for match in re.finditer(r"<!--", source)]


def hash_line_findings(name, source, allow_shebang):
    found = []
    for number, line in enumerate(source.splitlines(), 1):
        if allow_shebang and number == 1 and line.startswith(HASH + "!"):
            continue
        if TRAILING_HASH.search(QUOTED.sub('""', line)):
            found.append((name, number, "comment"))
    return found


def findings_for(name, source):
    suffix = pathlib.PurePosixPath(name).suffix.lower()
    first = source.splitlines()[0] if source else ""
    if suffix == ".py" or first.startswith(SCRIPT_SHEBANGS):
        return python_findings(name, source)
    if suffix in TS_FAMILY:
        return ts_findings(name, source)
    if suffix in STYLE_FAMILY:
        return style_findings(name, source)
    if suffix in HTML_FAMILY:
        return html_findings(name, source)
    if suffix in YAML_FAMILY:
        return hash_line_findings(name, source, False)
    if suffix in SHELL_FAMILY or first.startswith(HASH + "!"):
        return hash_line_findings(name, source, True)
    return []


def main():
    root = pathlib.Path(os.environ.get("NO_COMMENTS_ROOT") or ".").resolve()
    found = []
    scanned = 0
    for name in tracked_files(root):
        source = read_text(root / name)
        if source is None:
            continue
        scanned += 1
        found.extend(findings_for(name, source))
    for name, line, kind in sorted(found):
        print(f"{name}:{line} {kind}")
    print(f"no-comments: {len(found)} finding(s) in {scanned} text files")
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main())
