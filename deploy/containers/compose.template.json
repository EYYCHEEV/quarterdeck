{
  "name": "quarterdeck",
  "services": {
    "caddy": {
      "image": "${image:caddy-source}",
      "user": "2300:2300",
      "command": ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"],
      "read_only": true,
      "cap_drop": ["ALL"],
      "cap_add": ["NET_BIND_SERVICE"],
      "security_opt": ["no-new-privileges:true"],
      "init": true,
      "restart": "unless-stopped",
      "stop_grace_period": "30s",
      "pids_limit": 96,
      "mem_limit": "256m",
      "memswap_limit": "256m",
      "cpus": "0.5",
      "ulimits": {"nofile": {"soft": 1024, "hard": 1024}},
      "tmpfs": ["/tmp:rw,nosuid,nodev,noexec,size=16m"],
      "ports": ["${deployment:caddy-port-mapping}"],
      "networks": {
        "edge": {},
        "service": {"ipv4_address": "${deployment:caddy-address}"}
      },
      "volumes": [
        "${QD_ROOT}/config/caddy/Caddyfile:/etc/caddy/Caddyfile:ro",
        "${QD_ROOT}/volumes/caddy-data:/data:rw",
        "${QD_ROOT}/volumes/caddy-config:/config:rw"
      ],
      "logging": {"driver": "json-file", "options": {"max-size": "5m", "max-file": "3"}}
    },
    "stalwart": {
      "image": "${image:stalwart-runtime}",
      "user": "2000:2000",
      "read_only": true,
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "init": true,
      "restart": "unless-stopped",
      "stop_grace_period": "30s",
      "pids_limit": 256,
      "mem_limit": "2g",
      "memswap_limit": "2g",
      "cpus": "2.0",
      "ulimits": {"nofile": {"soft": 4096, "hard": 4096}},
      "tmpfs": [
        "/tmp:rw,nosuid,nodev,noexec,size=64m",
        "/run:rw,nosuid,nodev,noexec,size=16m"
      ],
      "networks": {"service": {"ipv4_address": "${deployment:stalwart-address}"}},
      "volumes": [
        "${QD_ROOT}/config/stalwart:/etc/stalwart:ro",
        "${QD_ROOT}/volumes/stalwart-data:/var/lib/stalwart:rw",
        "${QD_ROOT}/volumes/stalwart-logs:/var/log/stalwart:rw",
        "${QD_ROOT}/state/first-start:/var/lib/quarterdeck:ro"
      ],
      "logging": {"driver": "json-file", "options": {"max-size": "10m", "max-file": "5"}}
    },
    "join": {
      "image": "${image:python-source}",
      "user": "2100:2100",
      "group_add": ["2400", "2501"],
      "working_dir": "/opt/quarterdeck/connect",
      "command": ["python3", "/opt/quarterdeck/connect/public_join.py", "--config", "/var/lib/quarterdeck-join/runtime.json"],
      "environment": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1",
        "PYTHONPATH": "/opt/quarterdeck/signup:/opt/quarterdeck/shared:/opt/quarterdeck/qd-mail-stalwart"
      },
      "read_only": true,
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "init": true,
      "restart": "unless-stopped",
      "stop_grace_period": "30s",
      "pids_limit": 96,
      "mem_limit": "512m",
      "memswap_limit": "512m",
      "cpus": "0.75",
      "ulimits": {"nofile": {"soft": 1024, "hard": 1024}},
      "tmpfs": ["/tmp:rw,nosuid,nodev,noexec,size=32m", "/run:rw,nosuid,nodev,noexec,size=8m"],
      "networks": {"service": {"ipv4_address": "${deployment:join-address}"}},
      "volumes": [
        "${QD_PACKAGE}/golive/connect:/opt/quarterdeck/connect:ro",
        "${QD_PACKAGE}/signup:/opt/quarterdeck/signup:ro",
        "${QD_PACKAGE}/golive/shared:/opt/quarterdeck/shared:ro",
        "${QD_PACKAGE}/qd-mail-stalwart:/opt/quarterdeck/qd-mail-stalwart:ro",
        "${QD_ROOT}/volumes/join-state:/var/lib/quarterdeck-join:rw",
        "${QD_ROOT}/volumes/control:/run/quarterdeck-control:rw",
        "${QD_ROOT}/volumes/approval-socket:/run/quarterdeck-approval:rw"
      ],
      "logging": {"driver": "json-file", "options": {"max-size": "5m", "max-file": "3"}}
    },
    "helper": {
      "image": "${image:python-source}",
      "user": "2200:2200",
      "group_add": ["2400"],
      "working_dir": "/opt/quarterdeck/helper",
      "command": ["python3", "/opt/quarterdeck/helper/server.py", "--config", "/var/lib/quarterdeck-helper/runtime.json"],
      "environment": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1",
        "PYTHONPATH": "/opt/quarterdeck/signup:/opt/quarterdeck/qd-mail-stalwart"
      },
      "read_only": true,
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "init": true,
      "restart": "unless-stopped",
      "stop_grace_period": "30s",
      "pids_limit": 64,
      "mem_limit": "256m",
      "memswap_limit": "256m",
      "cpus": "0.5",
      "ulimits": {"nofile": {"soft": 512, "hard": 512}},
      "tmpfs": ["/tmp:rw,nosuid,nodev,noexec,size=16m", "/run:rw,nosuid,nodev,noexec,size=8m"],
      "network_mode": "service:stalwart",
      "depends_on": {"stalwart": {"condition": "service_started"}},
      "volumes": [
        "${QD_PACKAGE}/golive/helper:/opt/quarterdeck/helper:ro",
        "${QD_PACKAGE}/signup:/opt/quarterdeck/signup:ro",
        "${QD_PACKAGE}/qd-mail-stalwart:/opt/quarterdeck/qd-mail-stalwart:ro",
        "${QD_ROOT}/volumes/helper-state:/var/lib/quarterdeck-helper:rw",
        "${QD_ROOT}/volumes/control:/run/quarterdeck-control:rw",
        "${QD_ROOT}/secrets/helper-admin:/run/quarterdeck-admin:ro"
      ],
      "logging": {"driver": "json-file", "options": {"max-size": "5m", "max-file": "3"}}
    },
    "approval": {
      "image": "${image:python-source}",
      "user": "2500:2500",
      "group_add": ["2501", "2701"],
      "working_dir": "/opt/quarterdeck/approval",
      "command": ["python3", "/opt/quarterdeck/approval/server.py", "--config", "/var/lib/quarterdeck-approval/runtime.json"],
      "environment": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1",
        "PYTHONPATH": "/opt/quarterdeck/captain-app:/opt/quarterdeck/signup:/opt/quarterdeck/shared"
      },
      "read_only": true,
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "init": true,
      "restart": "unless-stopped",
      "stop_grace_period": "30s",
      "pids_limit": 64,
      "mem_limit": "256m",
      "memswap_limit": "256m",
      "cpus": "0.5",
      "ulimits": {"nofile": {"soft": 512, "hard": 512}},
      "tmpfs": ["/tmp:rw,nosuid,nodev,noexec,size=16m", "/run:rw,nosuid,nodev,noexec,size=8m"],
      "networks": {
        "service": {"ipv4_address": "${deployment:approval-address}"},
        "egress": {}
      },
      "volumes": [
        "${QD_PACKAGE}/golive/approval:/opt/quarterdeck/approval:ro",
        "${QD_PACKAGE}/signup:/opt/quarterdeck/signup:ro",
        "${QD_PACKAGE}/golive/shared:/opt/quarterdeck/shared:ro",
        "${QD_PACKAGE}/captain-app:/opt/quarterdeck/captain-app:ro",
        "${QD_ROOT}/secrets/approval-secrets:/var/lib/quarterdeck-approval:rw",
        "${QD_ROOT}/volumes/approval-socket:/run/quarterdeck-approval:rw",
        "${QD_ROOT}/volumes/captain-auth:/run/quarterdeck-captain-auth:rw"
      ],
      "logging": {"driver": "json-file", "options": {"max-size": "5m", "max-file": "3"}}
    },
    "captain-app": {
      "image": "${image:python-source}",
      "user": "2700:2700",
      "group_add": ["2701"],
      "working_dir": "/opt/quarterdeck/captain-app",
      "command": ["python3", "/opt/quarterdeck/captain-app/server.py", "--config", "/var/lib/quarterdeck-captain/runtime.json"],
      "environment": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1",
        "PYTHONPATH": "/opt/quarterdeck/captain-app:/opt/quarterdeck/qd-cards:/opt/quarterdeck/qd-mail-stalwart:/opt/quarterdeck/approval:/opt/quarterdeck/shared:/opt/quarterdeck/door",
        "QD_CARD_LINK_ORIGIN": "${QD_CARD_LINK_ORIGIN}"
      },
      "read_only": true,
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "init": true,
      "restart": "unless-stopped",
      "stop_grace_period": "30s",
      "pids_limit": 96,
      "mem_limit": "384m",
      "memswap_limit": "384m",
      "cpus": "0.75",
      "ulimits": {"nofile": {"soft": 1024, "hard": 1024}},
      "tmpfs": ["/tmp:rw,nosuid,nodev,noexec,size=32m", "/run:rw,nosuid,nodev,noexec,size=8m"],
      "networks": {"service": {}},
      "volumes": [
        "${QD_PACKAGE}/captain-app:/opt/quarterdeck/captain-app:ro",
        "${QD_PACKAGE}/qd-cards:/opt/quarterdeck/qd-cards:ro",
        "${QD_PACKAGE}/qd-mail-stalwart:/opt/quarterdeck/qd-mail-stalwart:ro",
        "${QD_PACKAGE}/golive/approval:/opt/quarterdeck/approval:ro",
        "${QD_PACKAGE}/golive/shared:/opt/quarterdeck/shared:ro",
        "${QD_PACKAGE}/golive/door:/opt/quarterdeck/door:ro",
        "${QD_ROOT}/secrets/captain-mail-key:/run/quarterdeck-captain-mail:ro",
        "${QD_ROOT}/volumes/captain-state:/var/lib/quarterdeck-captain:rw",
        "${QD_ROOT}/volumes/captain-auth:/run/quarterdeck-captain-auth:rw"
      ],
      "logging": {"driver": "json-file", "options": {"max-size": "5m", "max-file": "3"}}
    }
  },
  "networks": {
    "edge": {
      "driver": "bridge",
      "driver_opts": {"com.docker.network.bridge.name": "qd-edge0"}
    },
    "service": {
      "driver": "bridge",
      "driver_opts": {"com.docker.network.bridge.name": "qd-svc0"},
      "internal": true,
      "ipam": {"config": [{"subnet": "${deployment:service-network}"}]}
    },
    "egress": {
      "driver": "bridge",
      "driver_opts": {"com.docker.network.bridge.name": "qd-egress0"},
      "ipam": {"config": [{"subnet": "${QD_EGRESS_SUBNET}"}]}
    }
  }
}
