{
  "name": "quarterdeck-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.21.0"
  },
  "workspaces": [
    "packages/contracts",
    "packages/client-runtime",
    "standin",
    "web"
  ],
  "scripts": {
    "typecheck": "effect-tsgo tsrs --noEmit",
    "lint": "vp lint",
    "test:unit": "vp test run --project unit",
    "test:browser": "vp test run --config web/vite.config.ts --project browser",
    "build": "vp build --config web/vite.config.ts --outDir ../dist --emptyOutDir",
    "build:a": "vp build --config web/vite.config.ts --outDir ../dist-a --emptyOutDir",
    "build:b": "vp build --config web/vite.config.ts --outDir ../dist-b --emptyOutDir",
    "check:builds": "node tools/compare-builds.mjs dist-a dist-b",
    "check:bundle": "python3 -B tools/check_bundle.py ../server/qd-web dist-a",
    "check:versions": "node tools/check-versions.mjs check package-lock.json tools/t3-versions.txt"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.1",
    "@effect/vitest": "4.1.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.13",
    "@types/node": "24.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "effect": "4.1.3",
    "oxc-transform-react": "0.152.0",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@babel/generator": "7.29.7",
    "@babel/helper-compilation-targets": "7.29.7",
    "@babel/helper-module-transforms": "7.29.7",
    "@babel/helper-string-parser": "7.29.7",
    "@babel/helpers": "7.29.7",
    "@babel/parser": "7.29.8",
    "@babel/runtime": "7.29.7",
    "@babel/traverse": "7.29.7",
    "@babel/types": "7.29.8",
    "@jridgewell/resolve-uri": "3.1.2",
    "@redis/bloom": "6.2.1",
    "@redis/client": "6.2.1",
    "@redis/json": "6.2.1",
    "@redis/search": "6.2.1",
    "@redis/time-series": "6.2.1",
    "@rolldown/pluginutils@^1": "1.0.1",
    "@testing-library/user-event": "14.6.7",
    "@types/estree": "1.0.9",
    "ansis": "4.3.1",
    "baseline-browser-mapping": "2.11.24",
    "browserslist": "4.29.0",
    "caniuse-lite": "1.0.30001810",
    "diff@^8": "8.0.3",
    "effect": "4.1.3",
    "electron-to-chromium": "1.5.430",
    "enhanced-resolve": "5.24.5",
    "graceful-fs": "4.2.11",
    "isbot": "5.1.40",
    "lightningcss": "1.33.0",
    "magic-string@^1": "1.4.3",
    "node-releases": "2.0.55",
    "postcss": "8.5.30",
    "prettier": "3.8.3",
    "readdirp@^5": "5.0.0",
    "redis": "6.2.1",
    "semver@^6": "6.3.1",
    "seroval": "1.7.10",
    "seroval-plugins": "1.7.8",
    "tapable": "2.3.3",
    "tinybench": "6.2.2",
    "unplugin": "3.0.0",
    "update-browserslist-db": "1.3.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5",
    "ws@^8": "8.22.0"
  }
}
